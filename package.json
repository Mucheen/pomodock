{
  "name": "pomodock",
  "version": "0.2.2",
  "private": true,
  "author": "Pomodock",
  "license": "MIT",
  "description": "A cross-platform edge-docked Pomodoro timer",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "test:smoke": "npm run build && electron scripts/smoke-check.cjs",
    "benchmark:memory": "npm run build && electron scripts/memory-benchmark.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5188 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5188 electron .\"",
    "dev:web": "vite",
    "lite:dev": "tauri dev",
    "lite:build": "tauri build",
    "lite:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lite:licenses": "node scripts/lite-notices.cjs",
    "build": "vite build",
    "dist": "npm run build && electron-builder --config.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac --config.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.pomodock.app",
    "productName": "Pomodock",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW",
      "zh_CN",
      "zh_TW"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "format": "ULFO"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
